# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

# UWAGA: ten plik trafia do repozytorium, bo "docker compose" czyta wylacznie
# jego - kontenery i aplikacja musza widziec te same porty i ten sam sekret
# huba. Sekrety (APP_SECRET, ADMIN_PASSWORD) siedza w .env.local.
#
# Nie kopiuj tu calego .env do .env.local "na zapas": przy poprzednich
# przenosinach oba pliki rozjechaly sie tak, ze aplikacja generowala adresy
# z .env.local, a kontenery i bin/dev startowaly z wartosciami z .env.

###> symfony/framework-bundle ###
# prod: APP_DEBUG derywuje sie z tego automatycznie w Dotenv::bootEnv() (0, bo
# "prod" jest w liscie prodEnvs) - nie trzeba go ustawiac osobno. Bez tego
# kazdy blad aplikacji pokazywal internetowi stos wywolan i sciezki na dysku.
APP_ENV=prod
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> nasze-gierki ###
# Adres, pod ktorym gre widza telefony i telewizor. Za reverse proxy jest to
# adres publiczny - TLS konczy sie na proxy, wiec to NIE jest adres nasluchu.
# Te dwie rzeczy trzeba trzymac osobno; sklejone w jedna zmienna daly adres
# "http://host:443", czyli schemat jednego wdrozenia z portem drugiego.
PUBLIC_URL=https://gierkownia.j33.pl

# Gdzie nasluchuje serwer PHP i dokad celuje proxy.
# Nie 0.0.0.0: port bylby wtedy osiagalny wprost z internetu, z pominieciem
# TLS, a naglowki X-Forwarded-* daloby sie podrobic i podszyc pod HTTPS.
# 10.0.7.1 to brama sieci dockerowej, w ktorej stoi nginx-proxy-manager -
# proxy widzi hosta wlasnie pod tym adresem, a swiat nie widzi go wcale.
# W czystym LAN (bez proxy) wpisz tu 0.0.0.0.
APP_BIND=10.0.7.1
APP_PORT=8210

# Adresy, spod ktorych wolno wierzyc naglowkom X-Forwarded-*. Tylko kontener
# proxy. Pusta wartosc = aplikacja uzna polaczenie za nieszyfrowane i zacznie
# budowac adresy z http:// - a wtedy przegladarka zablokuje SSE jako mixed
# content i gra zamrze na nieaktualnym tablo.
TRUSTED_PROXIES=10.0.7.3

# Katalog z muzyka do "Jaka to melodia". Poza repozytorium - pliki sa duze
# i nie nasze. Sciezki w taliach sa wzgledne wobec tego katalogu.
MEDIA_DIR=%kernel.project_dir%/var/media
# Haslo do panelu tresci (/admin). Puste = panel wylaczony, co jest
# bezpiecznym stanem poczatkowym. Ustaw je w .env.local, nie tutaj.
ADMIN_PASSWORD=
# Haslo do zalozenia pokoju (zostania hostem) - osobne od ADMIN_PASSWORD.
# Puste = zakladanie pokoju otwarte dla kazdego, jak dotychczas. Bez tego
# kazdy, kto trafi na strone glowna publicznej domeny, mogl zostac hostem.
# Ustaw je w .env.local, nie tutaj.
HOST_PASSWORD=
###< nasze-gierki ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=${PUBLIC_URL}
###< symfony/routing ###

###> symfony/mercure-bundle ###
# Hub Mercure. MERCURE_URL - z backendu (publikacja), MERCURE_PUBLIC_URL -
# z przegladarki telefonu/TV (subskrypcja SSE).
MERCURE_PORT=3010
# Na jakim adresie hosta publikowany jest kontener huba. Musi byc widoczny
# i dla proxy (przepuszcza SSE do przegladarki), i dla backendu (publikuje).
MERCURE_BIND=10.0.7.1
MERCURE_URL=http://${MERCURE_BIND}:${MERCURE_PORT}/.well-known/mercure
MERCURE_PUBLIC_URL=${PUBLIC_URL}/.well-known/mercure
# Port huba widziany przez przegladarke. 0 = ten sam adres co aplikacja, czyli
# hub przepuszczony przez to samo proxy pod sciezka /.well-known/mercure.
# W czystym LAN wpisz tu ${MERCURE_PORT} - hub stoi wtedy obok, na swoim porcie.
MERCURE_PUBLIC_PORT=0
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="4ccd48ddb1d1259b0d4b69c657a55b709d9faaa3442454f939eb5f8b384d0234"
###< symfony/mercure-bundle ###

###> redis ###
# Stan live pokoju. Wlasny kontener - port 6379 zajmuje inny projekt.
# Publikowany wylacznie na 127.0.0.1 (patrz compose.yaml): Redis nie ma hasla,
# wiec na publicznym adresie zostalby przejety w kilka godzin.
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}
# TTL kluczy pokoju w sekundach (6h) - stan sprzata sie sam po imprezie.
ROOM_TTL=21600
###< redis ###

###> doctrine/doctrine-bundle ###
POSTGRES_DB=gierki
POSTGRES_USER=gierki
POSTGRES_PASSWORD=gierki
POSTGRES_PORT=55432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

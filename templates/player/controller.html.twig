{% extends 'base.html.twig' %}

{% block title %}{{ team.name }} — pokój {{ room.code }}{% endblock %}
{% block body_class %}player{% endblock %}

{% block body %}
    {# Sterownik drużyny - układ wg makiet w _other/: marka u góry, pod nią
       pasek z nazwą gry (dokłada go moduł), potem drużyna i punkty, a resztę
       ekranu zajmuje jedna wielka akcja.

       Nazwy gry nie ma tutaj celowo: rdzeń nie zna żadnej konkretnej gry
       (spec §7), więc pasek tytułu należy do szablonu modułu. #}
    <main class="player-screen" style="--team-color: {{ team.color }}"
          data-controller="player-status"
          data-player-status-hub-value="{{ hubUrl }}"
          data-player-status-team-value="{{ team.id }}"
          data-player-status-game-value="{{ gameType ?? '' }}">

        {# Host usunął tę drużynę z pokoju - nakładka na CAŁY ekran, żeby nie
           dało się dalej grać telefonem, który nie ma już do czego wracać
           (drużyny nie ma już w Redisie, każde kolejne zgłoszenie i tak
           dostałoby odmowę). #}
        <div class="player-removed-overlay" data-player-status-target="removedOverlay" hidden>
            <p class="player-removed-title">Zostaliście usunięci z pokoju</p>
            <p class="player-removed-note">Host wyrzucił tę drużynę z gry. Możecie dołączyć ponownie pod nową nazwą.</p>
            <a class="btn btn-primary btn-lg" href="{{ path('player_join', {code: room.code}) }}">Dołącz ponownie</a>
        </div>

        {# Drużyna i punkty to tylko mała informacja w pasku - resztę ekranu
           telefonu ma zająć samo granie. #}
        <header class="player-bar">
            <p class="player-brand">{{ include('_brand/logo.html.twig', {small: true}) }}</p>
            <span class="player-who">
                <span class="player-who-dot"></span>
                <span class="player-who-name">{{ team.name }}</span>
                <span class="player-who-score"><b data-player-status-target="score">{{ score }}</b> pkt</span>
            </span>
            <span class="conn" data-player-status-target="connection" data-state="connecting" aria-live="polite" role="status">łączenie…</span>
        </header>

        <section class="player-main">
            {% if gameType is not null %}
                {# Widok modułu gry po konwencji game/{typ}/player. #}
                {{ include('game/' ~ gameType ~ '/player.html.twig') }}
            {% else %}
                <p class="waiting" data-player-status-target="waiting">
                    Czekaj na hosta — gra zaraz się zacznie.
                </p>
            {% endif %}
        </section>

        <footer class="player-footer">
            <span class="muted">pokój {{ room.code }}</span>
        </footer>
    </main>
{% endblock %}

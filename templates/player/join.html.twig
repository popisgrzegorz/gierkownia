{% extends 'base.html.twig' %}

{% block title %}Dołącz — pokój {{ room.code }}{% endblock %}
{% block body_class %}player screen-center{% endblock %}

{% block body %}
    <main class="panel">
        <p class="muted">Pokój</p>
        <h1 class="room-code small">{{ room.code }}</h1>

        <form method="post" action="{{ path('room_join', {code: room.code}) }}" class="join-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('room') }}">
            <label for="name">Nazwa drużyny</label>
            {# autofocus + enterkeyhint: gracz wpisuje nazwe jedna reka, w biegu #}
            <input id="name" name="name" maxlength="24" required autofocus
                   autocomplete="off" enterkeyhint="go" placeholder="np. Kanapowcy">
            <button type="submit" class="btn btn-primary btn-lg">Wchodzę!</button>
        </form>

        {% if teams is not empty %}
            <p class="muted">Już w grze:</p>
            <ul class="teams-inline">
                {% for team in teams %}
                    <li style="--team-color: {{ team.color }}">{{ team.name }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}

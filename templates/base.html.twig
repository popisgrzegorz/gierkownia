<!DOCTYPE html>
{# Blok hot-reload FrankenPHP celowo usuniety: ciagnal skrypty z jsdelivr,
   a aplikacja ma dzialac w LAN bez internetu (spec 15). #}
<html lang="pl">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#160f3a">
        <meta name="description" content="Gry towarzyskie na telewizor i telefony gości w tej samej sieci - bez zakładania kont.">
        <title>{% block title %}Nasze Gierki{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.1em%22 font-size=%22104%22>🎲</text></svg>">
        {# manifest.json/ikony siedzą w public/ (poza AssetMapperem) - potrzebują
           stałych, nieodciśniętych adresów, żeby przeglądarka i system
           je rozpoznały (P2-28 audytu, kamień 4). #}
        <link rel="manifest" href="/manifest.json">
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">

        {% block stylesheets %}
            {# Tabler (Bootstrap 5) daje siatkę, odstępy i komponenty - zwłaszcza
               na telefonie, gdzie własny CSS wymagał ręcznego dopieszczania
               każdego breakpointu.

               Wersja PINOWANA, nie @latest: wydanie w górę potrafi przestawić
               układ bez uprzedzenia, a tego nikt nie chce odkryć przy stole.

               UWAGA: to jedyna zależność z sieci w runtime. Świadome odstępstwo
               od spec §15 - gra stoi pod publiczną domeną, więc internet i tak
               jest warunkiem wejścia. Gdyby wróciła praca w LAN bez internetu,
               ściągnij ten plik do assets/styles/vendor/ i podmień href. #}
            <link rel="stylesheet"
                  href="https://cdn.jsdelivr.net/npm/@tabler/core@1.4.0/dist/css/tabler.min.css">
            {# Nasz CSS po Tablerze - dopowiada to, czego framework nie umie:
               skalę czytelną z 3 metrów na telewizorze i pełnoekranowy buzzer. #}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            {# Fonty: Baloo 2 (tytuły, logo), Nunito (tekst), Caveat (odręczne
               dopiski) - wszystkie z pełnym polskim alfabetem. Makieta miała
               Lilita One, ale ta nie ma „ą ć ę ń ś ź ż”: przeglądarka
               dociągała je z innej czcionki i tytuły wyglądały na zepsute. Z sieci, jak Tabler - gra i tak stoi
               pod publiczną domeną; bez internetu spadają do systemowych. #}
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Baloo+2:wght@700;800&family=Nunito:wght@600;700;800;900&display=swap">
            {# Motyw „Gierkownia” (makieta var/gierkownia.png) - nadpisuje
               app.css tam, gdzie zmienia wygląd ekranu TV i strony startowej. #}
            <link rel="stylesheet" href="{{ asset('styles/gierkownia.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
<script src="/tv-remote.js" defer></script>
    </head>
    {# data-bs-theme: Tabler ma wbudowany tryb ciemny, a gra jest ciemna
       z założenia - jasny framework na telewizorze oślepiałby pokój. #}
    <body class="{% block body_class %}{% endblock %}" data-bs-theme="dark">
        {# Nazwany blok, zeby admin/login.html.twig mogl go nadpisac pustym -
           inaczej ten loop konsumowalby app.flashes PRZED blokiem body, a
           wlasny, wyglosowany alert Tablera w panelu nigdy nie dostawalby
           wiadomosci (zawsze pusta lista - P2-27 audytu). #}
        {% block flashes %}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <p class="flash flash-{{ label }}">{{ message }}</p>
                {% endfor %}
            {% endfor %}
        {% endblock %}

        {% block body %}{% endblock %}
    </body>
</html>

{% extends 'base.html.twig' %}

{% block title %}Gierkownia{% endblock %}
{% block body_class %}home{% endblock %}

{% block body %}
    {# Strona startowa w motywie z makiety (var/gierkownia.png): logo, „Nowa
       gra” i „Wznów turniej” dla telewizora, karta „Na telefonie” dla gości.
       Dwie drogi wejścia rozdzielone, bo to dwie różne osoby przy dwóch
       różnych ekranach - na telefonie karta dołączania idzie na górę. #}
    {% set meta = {
        'dutch':              {c: '#1e7bf0', hook: 'Zapamiętaj karty'},
        'kalambury':          {c: '#e8336d', hook: 'Pokaż bez słów'},
        'kalambury-rysowane': {c: '#7b3fe4', hook: 'Rysuj i zgaduj'},
        'kolo':               {c: '#f39a12', hook: 'Kręć i wygrywaj'},
        'melodia':            {c: '#119fc0', hook: 'Posłuchaj i odgadnij'},
        'melodia-quiz':       {c: '#8a3ff0', hook: 'Wybierz odpowiedź'},
        'ostatnia-litera':    {c: '#2fb24c', hook: 'Słowa i refleks'},
        'panstwa-miasta':     {c: '#f2622a', hook: 'Klasyka w nowej odsłonie'},
    } %}
    <main class="gk-home">
        <h1 class="gk-home-logo">{{ include('_brand/logo.html.twig') }}</h1>

        <section class="gk-home-host">
            <form method="post" action="{{ path('room_create') }}" class="host-form gk-host-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('room') }}">
                {% if hostPasswordNeeded %}
                    {# Tylko tutaj, raz - sesja zapamięta hosta i kolejne
                       pokoje nie będą już o to pytać (HostAccess). #}
                    <input type="password" name="hostPassword" class="gk-input"
                           placeholder="Hasło hosta" autocomplete="current-password" required>
                {% endif %}
                <button type="submit" class="gk-btn gk-btn-primary gk-btn-xl">
                    <span class="gk-play" aria-hidden="true"></span> Nowa gra
                </button>
            </form>
            <a class="gk-btn gk-btn-secondary" href="{{ path('tournament_list') }}">
                <span aria-hidden="true">⟳</span> Wznów turniej
            </a>
            <p class="gk-home-note">Na telewizorze: załóż pokój — pojawi się kod i QR dla gości.</p>
        </section>

        <section class="gk-card gk-home-join">
            <h2 class="gk-card-title"><span class="gk-phone" aria-hidden="true"></span> Na telefonie</h2>
            <form method="get" action="{{ path('room_join_by_code') }}" class="gk-join-form" data-controller="join-by-code">
                <label class="gk-eyebrow" for="gk-code">Wpisz kod pokoju</label>
                <div class="gk-join-row">
                    <input id="gk-code" name="code" class="code-input gk-input gk-code-input" maxlength="4" autocomplete="off"
                           autocapitalize="characters" spellcheck="false" placeholder="ABCD"
                           aria-label="Kod pokoju" data-join-by-code-target="input">
                    <button type="submit" class="gk-btn gk-btn-blue">Dołącz</button>
                </div>
            </form>
            <p class="gk-home-url">Kod widać na ekranie telewizora.</p>
        </section>

        <section class="gk-home-games">
            <h2 class="gk-section-title">Nasze gry</h2>
            <ul class="gk-home-wall">
                {% for game in games %}
                    {% set m = meta[game.type]|default({c: '#6b5cff', hook: ''}) %}
                    <li class="gk-tile gk-tile-static" style="--c: {{ m.c }};">
                        <span class="gk-tile-art">
                            {{ include(['game/' ~ game.type ~ '/art.html.twig', 'game/_art.html.twig']) }}
                        </span>
                        <span class="gk-tile-name">{{ game.name }}</span>
                        <span class="gk-tile-hook">{{ m.hook }}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    </main>
{% endblock %}

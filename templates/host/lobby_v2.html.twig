{# ------------------------------------------------------------------------
   Ekran wyboru gry — WERSJA 2 (domyślna; stara pod ?v=1).

   Koncept: pełnoekranowa „ściana gier". Każdy tytuł to nasycony panel w swoim
   kolorze, na całą wysokość — jak rząd automatów w salonie gier. Po LEWEJ
   pionowa kolumna dołączających graczy (mieści dużo nazwisk i przewija się,
   gdy jest ich naprawdę wielu), u góry dołączanie kodem i QR.

   Reużywa kontrolerów rdzenia: room-board (SSE: gracze, połączenie, pełny
   ekran), game-starter (start gry), sfx (dźwięk). Kolory i hasła gier trzyma
   lokalna mapa — dzięki temu v2 nie dotyka szablonów kafelków v1.
   ------------------------------------------------------------------------ #}
{% set meta = {
    'dutch':          {c: '#12b886', hook: 'Zapamiętaj, podmieniaj, wołaj „Dutch”!', e: '🃏'},
    'kalambury':      {c: '#30a46c', hook: 'Pokaż to bez słów — reszta zgaduje!',      e: '🎭'},
    'kolo':           {c: '#f5a524', hook: 'Zakręć kołem i zgarnij pulę!',             e: '🎡'},
    'melodia':        {c: '#3e63dd', hook: 'Pierwszy buzzer łapie tytuł!',             e: '💿'},
    'melodia-quiz':   {c: '#5b7cf0', hook: 'Cztery tytuły — jeden prawdziwy!',          e: '🎧'},
    'panstwa-miasta': {c: '#8e4ec6', hook: 'Litera, kategoria, czas — start!',          e: '🌍'},
} %}

<main class="l2"
      data-controller="room-board game-starter sfx"
      data-room-board-hub-value="{{ hubUrl }}"
      data-room-board-code-value="{{ room.code }}"
      data-game-starter-start-url-value="{{ path('game_start', {code: room.code}) }}">

    <header class="l2-top">
        <div class="l2-brand">
            <span class="l2-logo">GIERK<span class="l2-star">★</span>WNIA</span>
            <span class="l2-tag">wybierzcie grę</span>
        </div>

        <div class="l2-join">
            <div class="l2-join-text">
                <span class="l2-join-lead">Dołącz telefonem</span>
                <span class="l2-code">{{ room.code }}</span>
                <span class="l2-url">{{ joinUrl|replace({'http://': '', 'https://': ''}) }}</span>
            </div>
            <img class="l2-qr" src="{{ qr }}" alt="Kod QR pokoju {{ room.code }}" width="120" height="120">
        </div>
    </header>

    <div class="l2-body">
        {# Gracze po lewej, pionowo: kolumna mieści wielu i przewija się sama,
           gdy dołączy naprawdę duża ekipa. #}
        <aside class="l2-side">
            <div class="l2-side-head">
                <span class="l2-side-title">Gracze <span data-room-board-target="count">({{ teams|length }})</span></span>
                <span class="conn" data-room-board-target="connection" data-state="connecting">łączenie…</span>
            </div>

            <div class="l2-side-list">
                <p class="l2-empty" data-room-board-target="empty" {{ teams is not empty ? 'hidden' : '' }}>
                    czekamy na telefony…
                </p>
                <ul class="l2-players" data-room-board-target="list">
                    {% for team in teams %}
                        <li class="team" data-team-id="{{ team.id }}" style="--team-color: {{ team.color }}">
                            <span class="team-rank"></span>
                            <span class="team-name">{{ team.name }}</span>
                            <span class="team-score" data-score hidden>{{ team.score }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="l2-side-foot">
                <a class="l2-standings" href="{{ path('host_standings', {code: room.code}) }}" target="_blank" rel="noopener">🏆 Turniej</a>
                {# Pełny ekran przez ten sam mechanizm co w v1 (room-board#toggleFocus
                   → natywny requestFullscreen), chowa pasek adresu telewizora. #}
                <button type="button" class="l2-ctrl" data-action="room-board#toggleFocus">⛶ Pełny ekran</button>
            </div>
        </aside>

        {# Parzysta liczba gier układa się w dwa rzędy (6 → po 3), żeby panele nie
           robiły się za wąskie. Nieparzysta zostaje w jednym rzędzie - dwóch
           równych nie da się z niej złożyć bez sieroty. #}
        {% set n = games|length %}
        {% set even = n > 0 and n % 2 == 0 %}
        {% set cols = even ? (n / 2)|round(0, 'floor') : n %}
        <section class="l2-wall {{ even ? 'l2-wall-grid' : '' }}" style="--cols: {{ cols }}">
            {% for game in games %}
                {% set m = meta[game.type]|default({c: '#8d93b0', hook: 'Zagraj z telefonami gości.', e: '🎮'}) %}
                <button type="button" class="l2-panel" style="--c: {{ m.c }}"
                        data-game-type="{{ game.type }}" data-action="game-starter#start">
                    <span class="l2-emoji" aria-hidden="true">{{ m.e }}</span>
                    <span class="l2-name">{{ game.name }}</span>
                    <span class="l2-hook">{{ m.hook }}</span>
                    <span class="l2-go">GRAJ ▶</span>
                </button>
            {% endfor %}
        </section>
    </div>

    {# Kontroler klonuje ten szablon, gdy ktoś dołączy w trakcie. #}
    <template data-room-board-target="template">
        <li class="team team-new">
            <span class="team-rank"></span>
            <span class="team-name"></span>
            <span class="team-score" data-score hidden>0</span>
        </li>
    </template>
</main>

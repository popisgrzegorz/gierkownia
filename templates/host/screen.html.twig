{% extends 'base.html.twig' %}

{% block title %}Pokój {{ room.code }} — ekran hosta{% endblock %}
{% block body_class %}host{% endblock %}

{% block body %}
    {# Ekran wyboru gry ma dwie wersje: świeżą „ścianę gier" (v2, domyślna) i
       starą (v1) dostępną pod ?v=1. Dotyczy tylko poczekalni - po starcie gry
       i tak wchodzi normalny panel hosta. #}
    {% if gameType is null and app.request.query.get('v') != '1' %}
        {% include 'host/lobby_v2.html.twig' %}
    {% else %}
    {# Jeden kontroler na całą stronę: subskrybuje topic pokoju, aktualizuje
       tablo i rozsyła zdarzenia do panelu gry. Telewizor nigdy się nie odświeża.

       Układ: wąski pasek u góry, scena gry na całą resztę, drużyny w kolumnie
       z boku. Kod QR nie zajmuje ekranu na stałe - wysuwa się na żądanie, bo
       potrzebny jest tylko w momencie dołączania, a gra potrzebuje miejsca
       przez cały czas. #}
    {# Dźwięk siedzi na tym samym elemencie: efekty należą do telewizora, a nie
       do telefonów - jedna sala gra jednym głośnikiem, a dziesięć telefonów
       brzęczących z własnym opóźnieniem to hałas, nie efekt. #}
    <main class="tv"
          data-controller="room-board sfx tournament"
          data-room-board-hub-value="{{ hubUrl }}"
          data-room-board-code-value="{{ room.code }}">

        {# Poczekalnia dostaje pełny nagłówek z makiety (_other/layout2.png):
           duży logotyp po lewej, kod i QR po prawej. W trakcie gry ten sam
           nagłówek kurczy się do paska, bo plansza potrzebuje ekranu. #}
        <header class="tv-bar {{ gameType is null ? 'tv-bar-lobby' : '' }}">
            {% if gameType is null %}
                <div class="brand-block">
                    <h1 class="brand-word">GIERK<span class="brand-o">★</span>WNIA</h1>
                    <p class="brand-tag">gramy razem!</p>
                </div>

                <div class="join-inline">
                    <div class="join-inline-text">
                        <p class="join-inline-lead">Dołącz do gry na swoim telefonie</p>
                        <p class="join-inline-code">{{ room.code }}</p>
                        <p class="join-inline-url">
                            lub wejdź na: <strong>{{ joinUrl|replace({'http://': '', 'https://': ''}) }}</strong>
                        </p>
                    </div>
                    <img class="join-inline-qr" src="{{ qr }}" alt="Kod QR do pokoju {{ room.code }}"
                         width="320" height="320">
                </div>
            {% else %}
                <p class="tv-brand">GIERK<span class="brand-o">★</span>WNIA</p>
            {% endif %}

            <div class="tv-bar-right">
                <span class="conn" data-room-board-target="connection" data-state="connecting">łączenie…</span>

                {% if gameType is not null %}
                    <button type="button" class="btn btn-join" data-action="room-board#toggleJoin">
                        Dołącz <strong class="bar-code">{{ room.code }}</strong>
                    </button>
                {% endif %}

                {% if gameType is not null %}
                    {# Powrot do wyboru gry - druzyny i punkty zostaja, telefony
                       przelaczaja sie same po evencie fazy. #}
                    <form method="post" action="{{ path('game_stop', {code: room.code}) }}"
                          data-controller="soft-nav" data-action="submit->soft-nav#submit"
                          data-confirm="Zakończyć tę grę i wrócić do wyboru? Drużyny i punkty zostają.">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('room') }}">
                        <button type="submit" class="btn btn-ghost btn-reset">Zmień grę</button>
                    </form>
                {% endif %}

                <form method="post" action="{{ path('room_reset', {code: room.code}) }}" class="reset-form"
                      data-controller="soft-nav" data-action="submit->soft-nav#submit"
                      data-confirm="Zerować punkty i stan gry? Drużyny zostają w pokoju.">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('room') }}">
                    <button type="submit" class="btn btn-ghost btn-reset">Reset</button>
                </form>

                {# Pełna tablica wyników jako okienko modal - ranking wszystkich
                   uczestników na wierzchu ekranu, żywy z tego samego strumienia
                   co tablo z boku. #}
                <button type="button" class="btn btn-ghost btn-reset"
                        data-action="room-board#openStandings">🏆 Tablica wyników</button>

                {# Wyciszenie zapamiętuje się w przeglądarce telewizora: kto raz
                   ucisza grę na czas rozmowy, nie chce jej włączać po każdym
                   przeładowaniu ekranu. #}
                <button type="button" class="btn btn-ghost btn-reset"
                        data-sfx-target="button" data-action="sfx#toggle">🔊 Dźwięk</button>

                {# Cała scena na ekran: chowa ten pasek i punktację po lewej. #}
                <button type="button" class="btn btn-ghost btn-reset"
                        data-action="room-board#toggleFocus">⤢ Pełny ekran</button>
            </div>
        </header>

        {# Wyjście z pełnego ekranu, widoczne cały czas na TV - poza klawiszem
           Esc, którego przy telewizorze nikt nie ma pod ręką. #}
        <button type="button" class="tv-focus-exit" data-action="room-board#toggleFocus"
                title="Wyjdź z pełnego ekranu (Esc)" aria-label="Wyjdź z pełnego ekranu">⤡</button>

        {# Menu w pełnym ekranie: pasek u góry jest wtedy schowany razem z resztą,
           więc Zmień grę/Reset/Tablica/Dźwięk potrzebują osobnego, małego wejścia -
           inaczej jedynym sposobem dosięgnięcia ich byłoby najpierw wyjść
           z pełnego ekranu. Te same akcje co w pasku, tylko schowane za jednym
           przyciskiem. #}
        <button type="button" class="tv-focus-menu-btn" data-action="room-board#toggleFocusMenu"
                title="Menu" aria-label="Otwórz menu">☰</button>

        <div class="tv-focus-menu" data-room-board-target="focusMenu" hidden>
            {% if gameType is not null %}
                <button type="button" class="btn btn-ghost" data-action="room-board#toggleJoin">
                    Dołącz <strong class="bar-code">{{ room.code }}</strong>
                </button>

                <form method="post" action="{{ path('game_stop', {code: room.code}) }}"
                      data-controller="soft-nav" data-action="submit->soft-nav#submit"
                      data-confirm="Zakończyć tę grę i wrócić do wyboru? Drużyny i punkty zostają.">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('room') }}">
                    <button type="submit" class="btn btn-ghost btn-reset">Zmień grę</button>
                </form>
            {% endif %}

            <form method="post" action="{{ path('room_reset', {code: room.code}) }}" class="reset-form"
                  data-controller="soft-nav" data-action="submit->soft-nav#submit"
                  data-confirm="Zerować punkty i stan gry? Drużyny zostają w pokoju.">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('room') }}">
                <button type="submit" class="btn btn-ghost btn-reset">Reset</button>
            </form>

            <button type="button" class="btn btn-ghost btn-reset"
                    data-action="room-board#openStandings">🏆 Tablica wyników</button>

            <button type="button" class="btn btn-ghost btn-reset"
                    data-sfx-target="button" data-action="sfx#toggle">🔊 Dźwięk</button>

            <button type="button" class="btn btn-ghost btn-reset"
                    data-action="room-board#toggleFocus">⤡ Wyjdź z pełnego ekranu</button>
        </div>

        {# Panel dołączania wysuwa się WYŁĄCZNIE na żądanie - przyciskiem
           „Dołącz" w panelu punktacji. Otwierany sam po wejściu na ekran
           hosta zasłaniał grę każdemu, kto tylko odświeżył stronę. #}
        {% if gameType is not null %}
        <div class="join-drawer" data-room-board-target="joinPanel" hidden>
            <div class="join-card">
                <p class="join-lead">Dołącz na telefonie</p>
                <p class="room-code">{{ room.code }}</p>
                <img class="qr" src="{{ qr }}" alt="Kod QR do pokoju {{ room.code }}" width="320" height="320">
                <p class="join-url">{{ joinUrl|replace({'http://': '', 'https://': ''}) }}</p>
                <button type="button" class="btn btn-ghost" data-action="room-board#toggleJoin">Zamknij</button>
            </div>
        </div>
        {% endif %}

        {# Wyniki jako modal - tabela TURNIEJU (punkty za miejsca ze wszystkich
           gier), nie surowy wynik bieżącej gry. Ten drugi widać na tablo z boku.
           Lista żyje przez kontroler `tournament`: doszła gra → przestawia się.
           Klik w tło zamyka. #}
        <div class="standings-modal" data-room-board-target="standingsModal" hidden
             data-action="click->room-board#closeStandings">
            <div class="standings-modal-card" data-action="click->room-board#stop">
                <div class="standings-modal-head">
                    <h2 class="standings-modal-title">🏆 Turniej</h2>
                    <span class="standings-note" data-tournament-target="note">
                        {{ playedGames == 0 ? 'Turniej zacznie się po pierwszej grze.' : 'Po ' ~ playedGames ~ (playedGames == 1 ? ' grze.' : ' grach.') }}
                    </span>
                    <button type="button" class="btn btn-ghost" data-action="room-board#closeStandings"
                            aria-label="Zamknij">✕</button>
                </div>

                <ul class="standings-list teams" data-tournament-target="list">
                    {% for team in tournament %}
                        <li class="team" data-team-id="{{ team.id }}" style="--team-color: {{ team.color }}">
                            <span class="team-rank">{{ loop.index }}</span>
                            <span class="team-name">{{ team.name }}</span>
                            <span class="team-games">
                                {% for game in team.games|filter(g => g.points > 0) %}
                                    <span class="team-game-pill">{{ game.label }} +{{ game.points }}</span>
                                {% endfor %}
                            </span>
                            <span class="team-score" data-total>{{ team.total }}</span>
                        </li>
                    {% endfor %}
                </ul>

                {# Zapis turnieju do pliku - żeby wrócić następnego dnia. Nazwa
                   pomaga odnaleźć go na liście „Wznów". #}
                <form class="standings-save" method="post"
                      action="{{ path('tournament_save', {code: room.code}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('room') }}">
                    <input type="text" name="name" class="form-control" maxlength="60"
                           placeholder="Nazwa (np. Wieczór u Kasi)" autocomplete="off">
                    <button type="submit" class="btn">💾 Zapisz turniej</button>
                </form>

                <a class="standings-modal-link" href="{{ path('host_standings', {code: room.code}) }}"
                   target="_blank" rel="noopener">Otwórz na osobnym ekranie ↗</a>
            </div>
        </div>

        <div class="tv-body">
            {# Tablo po LEWEJ, na pełną wysokość: przyciski hosta u góry, pod nimi
               drużyny posortowane po punktach. Kolejność przestawia kontroler
               przy każdej zmianie wyniku - w kole fortuny punkty to wygrane
               pieniądze, więc miejsca zmieniają się w trakcie rundy. #}
            <aside class="tv-teams card">
                <div class="card-header teams-head-row">
                    <h2 class="card-title teams-head">
                        Punktacja <span class="text-secondary" data-room-board-target="count">({{ teams|length }})</span>
                    </h2>
                </div>

                <p class="empty text-secondary px-3" data-room-board-target="empty"
                   {{ teams is not empty ? 'hidden' : '' }}>
                    Czekam na telefony…
                </p>

                <ul class="teams" data-room-board-target="list">
                    {% for team in teams|sort((a, b) => b.score <=> a.score) %}
                        <li class="team" data-team-id="{{ team.id }}" style="--team-color: {{ team.color }}">
                            <span class="team-rank">{{ loop.index }}</span>
                            <span class="team-name">{{ team.name }}</span>
                            <span class="team-score" data-score>{{ team.score }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </aside>

            <section class="tv-stage {{ gameType is null ? 'tv-stage-lobby' : '' }}">
                {% if gameType is null %}
                    {# Gry z planu (spec §1), których moduły jeszcze nie powstały. Pokazujemy
                       je jako "wkrótce" i odsiewamy te, które już się wpięły - dzięki temu
                       kafelek zamienia się w grywalny sam, bez zmiany w tym pliku. #}
                    {% set planned = [
                        {name: 'Kalambury', color: '#30a46c', lead: 'Pokaż to bez słów. Reszta odgadnie!', type: 'kalambury'},
                        {name: 'Państwa Miasta', color: '#8e4ec6', lead: 'Litera, kategoria, czas start!', type: 'panstwa-miasta'}
                    ] %}
                    {% set registered = games|map(g => g.type) %}

                    <section class="game-grid" data-controller="game-starter"
                             data-game-starter-start-url-value="{{ path('game_start', {code: room.code}) }}">
                        {% for game in games %}
                            {# Kafelek modułu, jeśli go dostarczył; inaczej wersja zapasowa.
                               Rdzeń nie zna gier z nazwy - wygląd należy do modułu. #}
                            {{ include(
                                ['game/' ~ game.type ~ '/card.html.twig', 'game/_card.html.twig'],
                                {game: game}
                            ) }}
                        {% endfor %}

                        {% for soon in planned|filter(p => p.type not in registered) %}
                            <article class="game-card game-card-soon" style="--card: {{ soon.color }}">
                                <h3 class="game-card-title">{{ soon.name }}</h3>
                                <div class="game-card-art">
                                    <svg viewBox="0 0 120 120" aria-hidden="true">
                                        <rect x="20" y="20" width="80" height="80" rx="18" fill="none"
                                              stroke="currentColor" stroke-width="5" stroke-dasharray="10 8"/>
                                    </svg>
                                </div>
                                <p class="game-card-lead">{{ soon.lead }}</p>
                                <span class="game-card-btn game-card-btn-soon">wkrótce</span>
                            </article>
                        {% endfor %}
                    </section>

                    {# Dolny pas z makiety. "Ostatni zwycięzcy" to prawdziwe tablo
                       posortowane malejąco - wymyślona lista wyglądałaby ładnie
                       i kłamała przy pierwszej rozgrywce. #}
                    <div class="lobby-strip">
                        <section class="strip-tile">
                            <h2>Jak to działa?</h2>
                            <ol class="steps">
                                <li><span class="step-no">1</span><strong>Dołącz</strong><br>Zeskanuj kod QR albo wpisz kod gry na telefonie</li>
                                <li><span class="step-no">2</span><strong>Weź udział</strong><br>Telefon jest twoim pilotem do gry</li>
                                <li><span class="step-no">3</span><strong>Baw się razem</strong><br>Rywalizujcie i zdobywajcie punkty</li>
                            </ol>
                        </section>

                        <section class="strip-tile">
                            <h2>Ustawienia gry</h2>
                            <dl class="strip-rows">
                                <div><dt>Drużyn w pokoju</dt><dd>{{ teams|length }}</dd></div>
                                <div><dt>Kod pokoju</dt><dd>{{ room.code }}</dd></div>
                                <div><dt>Tryb</dt><dd>Drużyny</dd></div>
                            </dl>
                        </section>

                        <section class="strip-tile">
                            <h2>Tablo <span class="trophy">🏆</span></h2>
                            {% set ranked = teams|sort((a, b) => b.score <=> a.score) %}
                            {% if ranked is empty %}
                                <p class="muted">Jeszcze nikt nie gra.</p>
                            {% else %}
                                <ol class="strip-rank">
                                    {% for team in ranked %}
                                        <li><span>{{ team.name }}</span><strong>{{ team.score }}</strong></li>
                                    {% endfor %}
                                </ol>
                            {% endif %}
                        </section>
                    </div>
                {% else %}
                    {{ include('game/' ~ gameType ~ '/host.html.twig') }}
                {% endif %}
            </section>

        </div>

        {# Szablon kafelka drużyny - kontroler klonuje go zamiast sklejać HTML w JS.
           Musi leżeć WEWNĄTRZ elementu z data-controller: Stimulus szuka targetów
           tylko wśród potomków kontrolera, a target poza nim nie jest błędem
           składni - zgłasza się dopiero przy pierwszym użyciu, czyli gdy pierwszy
           telefon dołącza do pokoju. #}
        <template data-room-board-target="template">
            <li class="team team-new">
                <span class="team-rank"></span>
                <span class="team-name"></span>
                <span class="team-score" data-score>0</span>
            </li>
        </template>
    </main>
    {% endif %}
{% endblock %}

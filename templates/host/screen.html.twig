{% extends 'base.html.twig' %}

{% block title %}Pokój {{ room.code }} — ekran hosta{% endblock %}
{% block body_class %}host{% endblock %}

{% block body %}
    {# Jeden kontroler na całą stronę: subskrybuje topic pokoju, aktualizuje
       tablo i rozsyła zdarzenia do panelu gry. Telewizor nigdy się nie odświeża. #}
    <main class="tv"
          data-controller="room-board"
          data-room-board-hub-value="{{ hubUrl }}"
          data-room-board-code-value="{{ room.code }}"
          data-room-board-score-url-value="{{ path('game_score', {code: room.code}) }}">

        <header class="tv-header">
            <div class="brand">
                <h1 class="brand-name">NASZE<span class="brand-star">★</span>GIERKI</h1>
                <p class="brand-tag">gramy razem!</p>
            </div>

            <div class="join-box">
                <div class="join-text">
                    <p class="join-hint">Dołącz do gry na swoim telefonie</p>
                    <p class="room-code">{{ room.code }}</p>
                    <p class="join-hint">lub wejdź na: <strong>{{ joinUrl|replace({'http://': '', 'https://': ''}) }}</strong></p>
                </div>
                <img class="qr" src="{{ qr }}" alt="Kod QR do pokoju {{ room.code }}" width="320" height="320">
            </div>
        </header>

        {% if gameType is null %}
            {# Gry z planu (spec §1), których moduły jeszcze nie powstały. Pokazujemy
               je jako "wkrótce" i odsiewamy te, które już się wpięły - dzięki temu
               kafelek zamienia się w grywalny sam, bez zmiany w tym pliku. #}
            {% set planned = [
                {name: 'Kalambury', color: '#30a46c', lead: 'Pokaż to bez słów. Reszta odgadnie!', type: 'kalambury'},
                {name: 'Państwa Miasta', color: '#8e4ec6', lead: 'Litera, kategoria, czas start!', type: 'panstwa-miasta'}
            ] %}
            {% set registered = games|map(g => g.type) %}

            <section class="game-grid" data-controller="game-starter"
                     data-game-starter-start-url-value="{{ path('game_start', {code: room.code}) }}">
                {% for game in games %}
                    {# Kafelek modułu, jeśli go dostarczył; inaczej wersja zapasowa.
                       Rdzeń nie zna gier z nazwy - wygląd należy do modułu. #}
                    {{ include(
                        ['game/' ~ game.type ~ '/card.html.twig', 'game/_card.html.twig'],
                        {game: game}
                    ) }}
                {% endfor %}

                {% for soon in planned|filter(p => p.type not in registered) %}
                    <article class="game-card game-card-soon" style="--card: {{ soon.color }}">
                        <h3 class="game-card-title">{{ soon.name }}</h3>
                        <div class="game-card-art">
                            <svg viewBox="0 0 120 120" aria-hidden="true">
                                <rect x="20" y="20" width="80" height="80" rx="18" fill="none"
                                      stroke="currentColor" stroke-width="5" stroke-dasharray="10 8"/>
                            </svg>
                        </div>
                        <p class="game-card-lead">{{ soon.lead }}</p>
                        <span class="game-card-btn game-card-btn-soon">wkrótce</span>
                    </article>
                {% endfor %}
            </section>
        {% else %}
            {{ include('game/' ~ gameType ~ '/host.html.twig') }}
        {% endif %}

        <section class="tv-bottom">
            <div class="tile">
                <h2>Jak to działa?</h2>
                <ol class="steps">
                    <li><span class="step-no">1</span><strong>Dołącz</strong><br>Zeskanuj kod QR albo wpisz kod gry na telefonie</li>
                    <li><span class="step-no">2</span><strong>Weź udział</strong><br>Telefon jest twoim pilotem do gry</li>
                    <li><span class="step-no">3</span><strong>Baw się razem</strong><br>Rywalizujcie i zdobywajcie punkty</li>
                </ol>
            </div>

            <div class="tile">
                <h2>Drużyny <span class="muted" data-room-board-target="count">({{ teams|length }})</span></h2>

                <p class="empty" data-room-board-target="empty" {{ teams is not empty ? 'hidden' : '' }}>
                    Czekam na telefony…
                </p>

                <ul class="teams" data-room-board-target="list">
                    {% for team in teams %}
                        <li class="team" data-team-id="{{ team.id }}" style="--team-color: {{ team.color }}">
                            <span class="team-name">{{ team.name }}</span>
                            <span class="team-score" data-score>{{ team.score }}</span>
                            <span class="team-buttons">
                                <button type="button" class="btn btn-score" data-action="room-board#score" data-delta="-1"
                                        aria-label="Odejmij punkt drużynie {{ team.name }}">−</button>
                                <button type="button" class="btn btn-score" data-action="room-board#score" data-delta="1"
                                        aria-label="Dodaj punkt drużynie {{ team.name }}">+</button>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        <footer class="tv-footer">
            <span class="conn" data-room-board-target="connection" data-state="connecting">łączenie…</span>
            <span>Nasze Gierki — gry towarzyskie na każdą okazję</span>
            <span class="sep">|</span><span>Imprezy</span>
            <span class="sep">|</span><span>Wieczory rodzinne</span>
            <span class="sep">|</span><span>Spotkania ze znajomymi</span>

            <form method="post" action="{{ path('room_reset', {code: room.code}) }}" class="reset-form"
                  onsubmit="return confirm('Zerować punkty i stan gry? Drużyny zostają w pokoju.')">
                <button type="submit" class="btn btn-ghost">Reset gry</button>
            </form>
        </footer>
    </main>

    {# Szablon kafelka drużyny - kontroler klonuje go zamiast sklejać HTML w JS. #}
    <template data-room-board-target="template">
        <li class="team team-new">
            <span class="team-name"></span>
            <span class="team-score" data-score>0</span>
            <span class="team-buttons">
                <button type="button" class="btn btn-score" data-action="room-board#score" data-delta="-1">−</button>
                <button type="button" class="btn btn-score" data-action="room-board#score" data-delta="1">+</button>
            </span>
        </li>
    </template>
{% endblock %}

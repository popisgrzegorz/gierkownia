{% extends 'admin/_layout.html.twig' %}

{% block title %}Panel — {{ category.name }}{% endblock %}

{% block page_header %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row align-items-center">
                <div class="col">
                    <div class="page-pretitle">
                        <a href="{{ path('admin_categories') }}" class="text-secondary">← wszystkie kategorie</a>
                    </div>
                    <h2 class="page-title">{{ category.name }}</h2>
                    <div class="text-secondary mt-1">
                        {{ kindLabel }} · <code>{{ category.slug }}</code>
                        {% for game in category.games %}
                            <span class="badge bg-purple-lt ms-1">{{ game }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block admin %}
    <div class="row row-cards">
        <div class="col-12 col-lg-5">
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Nazwa kategorii</h3>
                </div>
                <div class="card-body">
                    {# Slug NIE zmienia się przy zmianie nazwy - siedzi w ścieżkach
                       wgranych plików i w stanie trwającej rozgrywki. #}
                    <form method="post" action="{{ path('admin_category_rename', {id: category.id}) }}"
                          class="row g-2 align-items-end">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin') }}">
                        <div class="col">
                            <input name="name" value="{{ category.name }}" class="form-control"
                                   aria-label="Nazwa kategorii" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn">Zmień</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Dodaj {{ singular }}</h3>
                </div>
                <div class="card-body">
                    {% if category.kind == 'melodia' %}
                        {# enctype jest tu obowiązkowe - bez niego plik nie dojdzie,
                           a formularz wygląda, jakby zadziałał. #}
                        <form method="post" action="{{ path('admin_item_create', {id: category.id}) }}"
                              enctype="multipart/form-data">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin') }}">
                            <div class="mb-3">
                                <label class="form-label" for="f-file">Plik</label>
                                <input id="f-file" type="file" name="file" accept="audio/*" class="form-control">
                            </div>
                            <div class="mb-3">
                                {# Albo plik, albo link - nagranie spod adresu nie ląduje
                                   na dysku, przeglądarka hosta pobiera je sama. #}
                                <label class="form-label" for="f-link">…albo link zewnętrzny</label>
                                <input id="f-link" name="sourceUrl" class="form-control" type="url"
                                       placeholder="https://serwer.pl/nagranie.mp3">
                                <small class="form-hint">
                                    Wypełnij jedno z dwóch. Link musi zaczynać się od https://
                                </small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="f-title">Tytuł</label>
                                <input id="f-title" name="title" class="form-control" placeholder="np. Lato, lato czeka">
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="f-artist">Wykonawca</label>
                                <input id="f-artist" name="artist" class="form-control" placeholder="np. Anna Jantar">
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="f-start">Start (s)</label>
                                <input id="f-start" name="startAt" type="number" min="0" value="0"
                                       class="form-control" inputmode="numeric">
                                <small class="form-hint">
                                    Sekunda, od której leci nagranie — refren rozpoznaje się szybciej niż wstęp.
                                </small>
                            </div>
                            <button type="submit" class="btn btn-primary">Wgraj</button>
                        </form>
                        <p class="text-secondary small mt-3 mb-0">
                            Formaty: {{ extensions|join(', ') }}. Limit pliku: {{ uploadLimit }}.
                            Listę linków hurtem wsypie <code>app:melodia:import</code>.
                        </p>

                    {% else %}
                        {# Jeden formularz na całą resztę: hasło jest wspólne dla
                           koła i kalambur, różnią się tylko pola poboczne. #}
                        <form method="post" action="{{ path('admin_item_create', {id: category.id}) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin') }}">
                            <div class="mb-3">
                                <label class="form-label" for="f-phrase">Hasło</label>
                                <input id="f-phrase" name="phrase" class="form-control"
                                       placeholder="np. Kot w butach" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="f-hint">Podpowiedź (koło fortuny)</label>
                                <input id="f-hint" name="hint" class="form-control"
                                       placeholder="np. bajka dla dzieci">
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="f-diff">Trudność (kalambury)</label>
                                <select id="f-diff" name="difficulty" class="form-select">
                                    <option value="latwy">łatwy</option>
                                    <option value="sredni" selected>średni</option>
                                    <option value="trudny">trudny</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary">Dodaj</button>
                        </form>
                        <p class="text-secondary small mt-3 mb-0">
                            Wpisuj naturalnie — koło fortuny samo zamienia hasło na wersaliki.
                            Polskie znaki są tam osobnymi literami: „Ł” nie odsłania „L”.
                        </p>
                    {% endif %}
                </div>
            </div>

            {% if category.kind != 'melodia' %}
                <div class="card mb-3">
                    <div class="card-header">
                        <h3 class="card-title">Kto korzysta z tej kategorii</h3>
                    </div>
                    <div class="card-body">
                        {# Odznaczenie gry NIE kasuje haseł - kategoria znika tylko
                           z jej listy wyboru u hosta. #}
                        <form method="post" action="{{ path('admin_category_games', {id: category.id}) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin') }}">
                            {% for label, game in phraseGames %}
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="games[]" value="{{ game }}"
                                           {{ game in category.games ? 'checked' : '' }}>
                                    <span class="form-check-label">{{ label }}</span>
                                </label>
                            {% endfor %}
                            <button type="submit" class="btn mt-3">Zapisz</button>
                        </form>
                    </div>
                </div>
            {% endif %}

            <div class="card card-stacked mb-3">
                <div class="card-status-top bg-danger"></div>
                <div class="card-header">
                    <h3 class="card-title">Usuń kategorię</h3>
                </div>
                <div class="card-body">
                    <p class="text-secondary">
                        Zniknie razem ze wszystkimi pozycjami{% if category.kind == 'melodia' %} i wgranymi plikami{% endif %}.
                        Tego nie da się cofnąć.
                    </p>
                    <form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}"
                          onsubmit="return confirm('Usunąć kategorię „{{ category.name|e('js') }}” i całą jej zawartość?')">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin') }}">
                        <button type="submit" class="btn btn-danger">Usuń kategorię</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">{{ plural }}</h3>
                    <span class="badge bg-secondary-lt ms-2">{{ items|length }}</span>
                </div>

                {% if items is empty %}
                    <div class="card-body text-secondary">Jeszcze pusto.</div>
                {% else %}
                    {# Tabela, bo pozycje mają stałe kolumny i porównuje się je
                       wzrokiem w pionie - przy nagraniach zwłaszcza pole "start". #}
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table">
                            <thead>
                                <tr>
                                    {% if category.kind == 'melodia' %}
                                        <th>Tytuł</th><th>Wykonawca</th><th class="w-1">Start</th><th>Plik lub link</th>
                                    {% else %}
                                        <th>Hasło</th><th>Podpowiedź</th><th style="width: 8rem">Trudność</th>
                                    {% endif %}
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in items %}
                                    <tr>
                                        {% if category.kind == 'melodia' %}
                                            <td>
                                                <input form="save-{{ item.id }}" name="title" value="{{ item.title }}"
                                                       class="form-control form-control-sm" aria-label="Tytuł">
                                            </td>
                                            <td>
                                                <input form="save-{{ item.id }}" name="artist" value="{{ item.artist }}"
                                                       class="form-control form-control-sm" aria-label="Wykonawca">
                                            </td>
                                            <td>
                                                <input form="save-{{ item.id }}" name="startAt" type="number" min="0"
                                                       value="{{ item.startAt }}" class="form-control form-control-sm"
                                                       aria-label="Start w sekundach">
                                            </td>
                                            <td class="text-truncate" style="max-width: 16rem">
                                                {% if item.isExternal %}
                                                    {# Link da się poprawić w miejscu - źródło potrafi
                                                       przenieść nagranie pod inny adres. #}
                                                    <input form="save-{{ item.id }}" name="sourceUrl" type="url"
                                                           value="{{ item.sourceUrl }}"
                                                           class="form-control form-control-sm"
                                                           aria-label="Link do nagrania">
                                                {% else %}
                                                    <span class="text-secondary" title="{{ item.path }}">
                                                        {{ item.path|split('/')|last }}
                                                    </span>
                                                {% endif %}
                                            </td>
                                        {% else %}
                                            <td>
                                                <input form="save-{{ item.id }}" name="phrase" value="{{ item.phrase }}"
                                                       class="form-control form-control-sm" aria-label="Hasło">
                                            </td>
                                            <td>
                                                <input form="save-{{ item.id }}" name="hint" value="{{ item.hint }}"
                                                       class="form-control form-control-sm" placeholder="podpowiedź"
                                                       aria-label="Podpowiedź">
                                            </td>
                                            <td>
                                                <select form="save-{{ item.id }}" name="difficulty" class="form-select form-select-sm">
                                                    {% for level in ['latwy', 'sredni', 'trudny'] %}
                                                        <option value="{{ level }}" {{ item.difficulty == level ? 'selected' : '' }}>{{ level }}</option>
                                                    {% endfor %}
                                                </select>
                                            </td>
                                        {% endif %}

                                        <td class="text-nowrap">
                                            {# Formularze leżą POZA tabelą, a pola wskazują je atrybutem "form".
                                               Wiersz tabeli nie może zawierać <form>, a bez tego zapis
                                               i usuwanie musiałyby być osobnymi kolumnami z ramkami. #}
                                            <button form="save-{{ item.id }}" type="submit" class="btn btn-sm">Zapisz</button>
                                            <button form="del-{{ item.id }}" type="submit"
                                                    class="btn btn-sm btn-ghost-danger" aria-label="Usuń">✕</button>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% for item in items %}
                        <form id="save-{{ item.id }}" method="post" class="d-none"
                              action="{{ path('admin_item_update', {type: category.kind == 'melodia' ? 'melodia' : 'haslo', id: item.id}) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin') }}">
                        </form>
                        <form id="del-{{ item.id }}" method="post" class="d-none"
                              action="{{ path('admin_item_delete', {type: category.kind == 'melodia' ? 'melodia' : 'haslo', id: item.id}) }}"
                              onsubmit="return confirm('Usunąć na pewno?')">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin') }}">
                        </form>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

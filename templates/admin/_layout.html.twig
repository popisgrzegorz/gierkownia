{% extends 'base.html.twig' %}

{% block body_class %}admin{% endblock %}

{% block body %}
    {# Standardowy układ panelu Tablera: górny pasek + page-wrapper + page-body.
       Panel obsługuje się myszą przy biurku, więc w przeciwieństwie do ekranów
       gry nie nadpisujemy tu niczego własnymi stylami - app.css wycofuje się
       z panelu przez body:not(.admin). #}
    <div class="page">
        <header class="navbar navbar-expand-md d-print-none">
            <div class="container-xl">
                <a class="navbar-brand navbar-brand-autodark me-3" href="{{ path('admin_categories') }}">
                    NASZE<span class="brand-star">★</span>GIERKI
                </a>
                <span class="text-secondary d-none d-md-inline">panel treści</span>

                <div class="ms-auto">
                    <form method="post" action="{{ path('admin_logout') }}">
                        <button type="submit" class="btn btn-outline-secondary">Wyloguj</button>
                    </form>
                </div>
            </div>
        </header>

        <div class="page-wrapper">
            {% block page_header %}{% endblock %}

            <div class="page-body">
                <div class="container-xl">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            {# Tabler rozróżnia typy alertów kolorem - "success" jest
                               zielony, wszystko inne traktujemy jak ostrzeżenie. #}
                            <div class="alert alert-{{ label == 'success' ? 'success' : 'warning' }}" role="alert">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {% block admin %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

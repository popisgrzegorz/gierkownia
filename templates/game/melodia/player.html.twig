{# Sterownik melodii wg _other/jaka_to_melodia.png: pasek z nazwą gry i jeden
   wielki okrągły STOP. Telefon trzymany w dłoni, często bez patrzenia - stąd
   koło na pół ekranu zamiast zgrabnego guzika. #}
<p class="game-tab c-bg-melodia">JAKA TO MELODIA</p>

<div class="buzzer"
     data-controller="melodia-player"
     data-melodia-player-action-url-value="{{ path('game_action', {code: room.code}) }}"
     data-melodia-player-team-id-value="{{ team.id }}"
     data-melodia-player-state-value="{{ game.hasFloor ? 'floor' : (game.excluded ? 'excluded' : (game.armed ? 'armed' : 'waiting')) }}"
     data-melodia-player-round-value="{{ game.round }}">

    <button type="button"
            class="buzzer-button"
            data-melodia-player-target="button"
            data-action="pointerdown->melodia-player#buzz">
        <span data-melodia-player-target="label">Czekaj…</span>
    </button>
</div>

<p class="action-caption">Naciśnij, gdy znasz odpowiedź</p>

{# Test melodii na ekranie hosta: cztery tytuły dla całego pokoju, odliczanie
   na płycie i wskaźniki „kto już odpowiedział".

   Poprawna odpowiedź NIE wychodzi na ten ekran przed końcem rundy - patrzą
   na niego ci sami ludzie, którzy odpowiadają na telefonach. #}
<section class="game-panel quiz-panel"
         data-controller="quiz-host"
         data-quiz-host-action-url-value="{{ path('game_action', {code: room.code}) }}"
         data-quiz-host-view-url-value="{{ path('game_view', {code: room.code}) }}"
         data-quiz-host-media-url-value="{{ path('host_media', {code: room.code, id: 0}) }}">

    {# Jeden głośnik w sali - dźwięk leci wyłącznie stąd (spec 10). #}
    <audio data-quiz-host-target="audio" preload="auto"></audio>

    <div class="game-rail">
        <h2 class="game-name">
            <span class="game-name-1">JAKA TO</span>
            <span class="game-name-2 c-quiz">MELODIA</span>
            <span class="game-badge">1 z 4</span>
        </h2>

        {# Kategoria i numer utworu przy tytule gry, a nie nad odpowiedziami -
           tam odbierały wysokość kartom, a tu domykają nagłówek szyny. #}
        <p class="panel-eyebrow" data-quiz-host-target="progress"></p>

        {# Kaseta magnetofonowa: szpule kręcą się tylko wtedy, gdy faktycznie leci
           dźwięk, a obrys obudowy skraca się z każdą sekundą rundy - na TV to
           jedyny sygnał, ile czasu zostało (zegar telefonu widzi tylko gracz).

           pathLength="100" na obrysie zwalnia nas z liczenia obwodu zaokrąglonego
           prostokąta: przeglądarka skaluje kreskowanie do stu jednostek. #}
        <div class="quiz-tape" data-quiz-host-target="disc">
            <svg viewBox="0 0 260 168" class="quiz-cassette" aria-hidden="true">
                <defs>
                    <linearGradient id="qc-shell" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#8c5cff"/>
                        <stop offset=".55" stop-color="#6a35e0"/>
                        <stop offset="1" stop-color="#4a1fb0"/>
                    </linearGradient>
                    <linearGradient id="qc-label" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#fffaf0"/>
                        <stop offset="1" stop-color="#f3e8d2"/>
                    </linearGradient>
                    <radialGradient id="qc-tape" cx=".5" cy=".5" r=".5">
                        <stop offset=".35" stop-color="#7a4a22"/>
                        <stop offset=".8" stop-color="#4f2e12"/>
                        <stop offset="1" stop-color="#3a210c"/>
                    </radialGradient>
                    <linearGradient id="qc-glass" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#1a1145"/>
                        <stop offset="1" stop-color="#0c0828"/>
                    </linearGradient>
                </defs>

                {# Obudowa z „grubością” pod spodem - jak naklejki z reszty motywu. #}
                <rect x="5" y="10" width="250" height="155" rx="16" fill="#2c1278"/>
                <rect class="tape-shell" x="5" y="5" width="250" height="155" rx="16"
                      fill="url(#qc-shell)" stroke="#1a1238" stroke-width="3.5"/>
                <path d="M20 9 H240" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".35"/>

                {# Pasek czasu biegnie po obrysie obudowy - kontroler skraca go co sekundę. #}
                <rect class="tape-run" data-quiz-host-target="ring"
                      x="5" y="5" width="250" height="155" rx="16"
                      pathLength="100" stroke-dasharray="100" stroke-dashoffset="0"/>

                {# Etykieta: na niej leży odczyt sekund, pod spodem tęczowe paski. #}
                <rect x="20" y="16" width="220" height="74" rx="9" fill="url(#qc-label)" stroke="#1a1238" stroke-width="2.5"/>
                <rect x="20" y="16" width="220" height="12" rx="6" fill="#ff5d8f"/>
                <rect x="20" y="22" width="220" height="6" fill="#ff5d8f"/>
                <g>
                    <rect x="22" y="70" width="216" height="4" fill="#ff5d8f"/>
                    <rect x="22" y="74" width="216" height="4" fill="#ffb000"/>
                    <rect x="22" y="78" width="216" height="4" fill="#2fb24c"/>
                    <rect x="22" y="82" width="216" height="4" fill="#1e9bf0"/>
                </g>
                <text x="30" y="26" font-family="'Baloo 2', sans-serif" font-weight="800" font-size="9" fill="#fff">A</text>
                <text x="230" y="26" font-family="'Baloo 2', sans-serif" font-weight="800" font-size="9" fill="#fff" text-anchor="end">1 z 4</text>

                {# Okienko z taśmą #}
                <rect x="44" y="96" width="172" height="40" rx="20" fill="url(#qc-glass)" stroke="#1a1238" stroke-width="2.5"/>
                <circle cx="84" cy="116" r="27" fill="url(#qc-tape)"/>
                <circle cx="176" cy="116" r="17" fill="url(#qc-tape)"/>
                <path class="tape-band" d="M84 143 H176"/>
                <g class="tape-hub tape-hub-left">
                    <circle cx="84" cy="116" r="11" fill="#fff" stroke="#1a1238" stroke-width="2.5"/>
                    <rect x="92.8" y="113.4" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(90 95.0 116.0)"/><rect x="87.3" y="122.9" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(150 89.5 125.5)"/><rect x="76.3" y="122.9" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(210 78.5 125.5)"/><rect x="70.8" y="113.4" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(270 73.0 116.0)"/><rect x="76.3" y="103.9" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(330 78.5 106.5)"/><rect x="87.3" y="103.9" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(390 89.5 106.5)"/>
                    <circle cx="84" cy="116" r="6.5" fill="#2b1f6e"/>
                    <path d="M84 109.5 V122.5 M78.4 112.8 L89.6 119.2 M78.4 119.2 L89.6 112.8" stroke="#fff" stroke-width="1.6" opacity=".55"/>
                </g>
                <g class="tape-hub tape-hub-right">
                    <circle cx="176" cy="116" r="11" fill="#fff" stroke="#1a1238" stroke-width="2.5"/>
                    <rect x="184.8" y="113.4" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(90 187.0 116.0)"/><rect x="179.3" y="122.9" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(150 181.5 125.5)"/><rect x="168.3" y="122.9" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(210 170.5 125.5)"/><rect x="162.8" y="113.4" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(270 165.0 116.0)"/><rect x="168.3" y="103.9" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(330 170.5 106.5)"/><rect x="179.3" y="103.9" width="4.4" height="5.2" rx="1" fill="#fff" transform="rotate(390 181.5 106.5)"/>
                    <circle cx="176" cy="116" r="6.5" fill="#2b1f6e"/>
                    <path d="M176 109.5 V122.5 M170.4 112.8 L181.6 119.2 M170.4 119.2 L181.6 112.8" stroke="#fff" stroke-width="1.6" opacity=".55"/>
                </g>
                <rect x="44" y="96" width="172" height="40" rx="20" fill="none" stroke="#1a1238" stroke-width="2.5"/>
                <path d="M60 101 H120" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity=".3"/>

                {# Stopka z otworami na trzpienie i śrubki - z nimi to kaseta,
                   bez nich zwykły prostokąt. #}
                <path d="M62 160 L74 141 H186 L198 160 Z" fill="#5a2cc9" stroke="#1a1238" stroke-width="2.5" stroke-linejoin="round"/>
                <circle class="tape-hole" cx="104" cy="152" r="4"/>
                <circle class="tape-hole" cx="130" cy="150" r="3"/>
                <circle class="tape-hole" cx="156" cy="152" r="4"/>
                <g fill="#c9b8ff" stroke="#1a1238" stroke-width="1.5">
                    <circle cx="14" cy="14" r="4"/><circle cx="246" cy="14" r="4"/>
                    <circle cx="14" cy="151" r="4"/><circle cx="246" cy="151" r="4"/>
                </g>
                <g stroke="#1a1238" stroke-width="1.3">
                    <path d="M12 14 H16 M244 14 H248 M12 151 H16 M244 151 H248"/>
                </g>
            </svg>

            <div class="quiz-readout">
                <span class="quiz-count" data-quiz-host-target="clockValue">--</span>
                <span class="quiz-count-label" data-quiz-host-target="clockLabel">SEKUND</span>
                <span class="quiz-eq" data-quiz-host-target="eq" aria-hidden="true">
                    {% for i in 1..7 %}<i></i>{% endfor %}
                </span>
            </div>
        </div>

        {# Drużyny pod kasetą, a nie w kolumnie z odpowiedziami: tam wisiały
           w pustce między kartami a przyciskiem, a tu domykają szynę. #}
        <div class="quiz-who" data-quiz-host-target="who"></div>

        <p class="tip-card">
            <strong>Wszyscy odpowiadają naraz.</strong> Na telefonie wybierz jeden z czterech tytułów.
        </p>
    </div>

    <div class="game-main">
        {# Kategorie zaznacza się jak listę - nagrania lecą ze wspólnej puli
           wszystkich wybranych, żeby wieczór nie brzmiał jednostajnie. #}
        <div class="cat-picker" data-quiz-host-target="categoryPicker" hidden>
            <p class="cat-picker-lead">Zaznacz kategorie — nagrania będą losowane ze wszystkich naraz</p>
            <div class="cat-list" data-quiz-host-target="categoryList"></div>
            <button type="button" class="btn btn-primary btn-lg" data-action="quiz-host#pickCategory">Graj</button>
        </div>

        {# Cztery odpowiedzi. Po rundzie kolorują się: zielona poprawna,
           czerwone błędnie wskazane, reszta przygaszona. #}
        <div class="quiz-options" data-quiz-host-target="options"></div>

        <p class="quiz-message" data-quiz-host-target="message"></p>

        <div class="panel-row" data-quiz-host-target="timeRow" hidden>
            <label for="quiz-seconds">Czas rundy</label>
            <select id="quiz-seconds" data-quiz-host-target="seconds" class="form-select select">
                <option value="15">15 s</option>
                <option value="30" selected>30 s</option>
                <option value="45">45 s</option>
                <option value="60">60 s</option>
            </select>
        </div>

        <div class="panel-row panel-controls" data-quiz-host-target="controls"></div>

        <p class="hint muted" data-quiz-host-target="hint"></p>
    </div>

    <p class="game-foot">Za trafiony tytuł 10 punktów. Jeśli nikt nie trafi — można puścić jeszcze raz.</p>
</section>

{# Kafelek państw i miast. Kolor i hasło należą do modułu, nie do rdzenia. #}
{% embed 'game/_card.html.twig' with {
    game: game,
    color: '#8e4ec6',
    lead: 'Litera, kategoria, czas start!'
} %}
    {% block art %}
        <svg viewBox="0 0 120 120" role="img" aria-label="Państwa i miasta">
            {# Kartka w kratkę z wielką literą - dokładnie to, co widać na TV. #}
            <rect x="22" y="14" width="76" height="92" rx="6" fill="none"
                  stroke="currentColor" stroke-width="5"/>
            <path d="M22 40 h76 M60 40 v66 M22 66 h76 M22 88 h76"
                  fill="none" stroke="currentColor" stroke-width="3" opacity="0.55"/>
            <text x="60" y="34" text-anchor="middle" font-size="20" font-weight="700"
                  fill="currentColor">A</text>
        </svg>
    {% endblock %}
{% endembed %}
